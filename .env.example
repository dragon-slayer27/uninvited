# Copy this file to .env (it is git-ignored). Every setting is optional.

# Enables the opt-in "Ask the web" lookup through SerpApi (free plan: 250 searches a month).
SERPAPI_KEY=

# Local model to use. Default gemma4:e4b-it-qat, then falls back to gemma4:e4b, gemma4, gemma4:e2b.
# UNINVITED_MODEL=gemma4:e2b

# Where Uninvited keeps its small cache, reports and Temporal history. Default: %LOCALAPPDATA%\Uninvited
# UNINVITED_HOME=D:\uninvited-data

# Path to the Temporal CLI, if it is not on PATH (used by `uninvited watch` to start a local dev server).
# UNINVITED_TEMPORAL_CLI=C:\tools\temporal\temporal.exe
